{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "title": "Frontend Available Replicas",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "max(kube_deployment_status_replicas_available{namespace=\"default\",deployment=~\"frontend.*\"})", "legendFormat": "available" }
      ]
    },
    {
      "title": "Frontend Ready Pods",
      "type": "state-timeline",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(kube_pod_status_ready{namespace=\"default\",pod=~\"frontend.*\",condition=\"true\"})", "legendFormat": "ready" }
      ]
    },
    {
      "title": "Frontend CPU Usage",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"default\",pod=~\"frontend.*\",container!=\"\"}[5m]))", "legendFormat": "CPU cores" }
      ]
    }
  ],
  "title": "Bilal Motors - Frontend Dashboard",
  "uid": "bilal-motors-frontend"
}